# Copy to .env on the server. Never commit the real file.
#   cp .env.example .env

GATEWAY_ADDR=127.0.0.1:8080
GATEWAY_TLS_ADDR=:8443
GATEWAY_TLS_CERT_FILE=/etc/kgram/tls/gateway-chain.pem
GATEWAY_TLS_KEY_FILE=/etc/kgram/tls/gateway-key.pem
# Public URL used to rewrite MinIO object links in proxied JSON.
GATEWAY_PUBLIC_URL=https://YOUR_HOST_OR_IP:8443

# Internal OpenIM endpoints (on the same host, plain HTTP is fine).
OPENIM_API_URL=http://127.0.0.1:10002
OPENIM_CHAT_URL=http://127.0.0.1:10008
OPENIM_WS_URL=ws://127.0.0.1:10001
OPENIM_MINIO_URL=http://127.0.0.1:10005

# Server-side only. Do not put these in git, client code, or PR descriptions.
OPENIM_SECRET=
OPENIM_ADMIN_USER=imAdmin
